{
  "name": "requestank",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run build && wrangler pages dev",
    "build": "ng build && npm run process",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:requestank": "node dist/requestank/server/server.mjs",
    "process": "node ./tools/copy-files.mjs",
    "deploy": "npm run build && wrangler pages deploy",
    "devnet": "concurrently \"ng serve\" \"dotnet run --project ../backend/Sazzle.Api\"",
    "cf-typegen": "wrangler types"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.0",
    "concurrently": "^10.0.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^22.20.5",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.147.0",
    "xhr2": "^0.2.1"
  }
}
